{
  "name": "mjsx",
  "private": true,
  "version": "0.0.1",
  "description": "JSX for microcontrollers, Raspberry Pi, desktop, and the browser \u2014 one core, several backends.",
  "workspaces": [
    "packages/*",
    "backends/*"
  ],
  "scripts": {
    "example:hello": "bun backends/pure-js/src/run.js examples/hello/app.jsx out/hello.ppm",
    "example:counter": "bun backends/pure-js/src/run.js examples/counter/app.jsx out/counter.ppm",
    "example:sensors": "bun backends/http/src/server.js examples/sensors/app.jsx",
    "example:sensors:terminal": "bun backends/terminal/src/interactive.js examples/sensors/app.jsx",
    "examples": "bun backends/terminal/src/launcher.js",
    "example:window": "bun backends/sdl/src/run.js examples/counter/app.jsx",
    "sim": "bun backends/sdl/src/sim.js",
    "sim:web": "bun backends/sdl/src/sim.js --http"
  }
}
